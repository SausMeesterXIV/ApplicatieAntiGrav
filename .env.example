# Kopieer naar .env en vul in. .env staat in .gitignore en komt nooit in git.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Publieke VAPID-sleutel voor pushmeldingen (zie supabase/README.md).
# De PRIVATE sleutel hoort hier NIET: die staat enkel als secret bij de edge function send-push.
VITE_VAPID_PUBLIC_KEY=
